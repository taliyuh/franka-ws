# Copy to .env and edit. docker compose reads it for both the container
# environment and ${...} substitution in docker-compose.yml.

# Tailscale address of 827 (`tailscale ip -4`). All viewer ports bind here.
TS_IP=100.117.27.103

# Host user the container runs as (`id -u`, `id -g` on 827).
CAM_UID=1001
CAM_GID=1004

# test = moving test pattern (dry run); v4l2 = real camera at CAM_DEVICE.
CAM_SOURCE=test
# RealSense colour node; find it with scripts/list-cams.sh.
# A /dev/v4l/by-id/... path survives replugging, /dev/videoN may not.
CAM_DEVICE=/dev/video0
CAM_INPUT_FORMAT=yuyv422
CAM_SIZE=1280x720
CAM_FPS=15
CAM_BITRATE=2M
CAM_LABEL="827 cell"

# How long recordings stay on disk before MediaMTX deletes them.
RECORD_KEEP=7d
# Where they are written (host path). Point at the external drive if you
# prefer to record there directly instead of archiving.
RECORDINGS_DIR=./recordings

SNAPSHOT_EVERY=5

# Cores the encoder may use. Leave the robot's control-loop cores out
# once those are decided (e.g. 2-19 if libfranka is pinned to 0-1).
CAM_CPUSET=0-19

# Login for the public (Funnel) link. Set with scripts/set-password.sh,
# which stores only a bcrypt hash here. Tailnet devices need no login.
VIEWER_USER=viewer
VIEWER_PASS_HASH=
