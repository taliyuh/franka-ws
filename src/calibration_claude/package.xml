<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>calibration_claude</name>
  <version>0.1.0</version>
  <description>
    Hand-eye (eye-to-hand) calibration pose driver for the Franka FR3: generates
    AprilTag-visibility-aware robot poses, drives the arm through them with a
    joint trajectory controller, and captures the raw data needed to solve the
    base-to-camera transforms offline.
  </description>
  <maintainer email="bartlomiej.hryniewski@gmail.com">bartek</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>franka_description</exec_depend>
  <exec_depend>franka_gazebo_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
